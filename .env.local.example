# Local Firebase emulator + Mailpit (see docker-compose.yml).
# Copy to .env.local or run: bash deploy/local/setup.sh
#
# Hyper-V Ubuntu guest: run bash deploy/hyperv/bootstrap.sh instead.
# Public sites are http(s)://*.ashlartechnologies.com on ports 80 and 443 only.

FIREBASE_PROJECT_ID=demo-masonic-bar
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-masonic-bar
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-masonic-bar.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-masonic-bar.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=1:0:web:demo

FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
USE_LOCAL_DB=false

JWT_SECRET=local-dev-secret-not-for-production
# Production / UAT must use a long random JWT_SECRET. The app refuses a weak secret in production.
# CRON_SECRET=
# ALLOW_MOCK_PAYMENTS=false
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Google Wallet (optional). Issuer ID from Google Pay & Wallet Console.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_SUFFIX=membership
# GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=/path/to/google-wallet.json
# GOOGLE_WALLET_LOGO_URL=

SMTP_HOST=127.0.0.1
SMTP_PORT=1125
SMTP_SECURE=false
EMAIL_FROM=Membership Manager <noreply@localhost>

# Apple Wallet. Local files live in certs/apple-wallet (pass.pem, pass.key, wwdr.pem).
# PASS_TYPE_IDENTIFIER=pass.com.ashlartechnologies.membership
# TEAM_IDENTIFIER=XVM6L7837J
# PASS_CERTIFICATE_PATH=certs/apple-wallet
# PASS_CERTIFICATE_PASSWORD=

# Hope Macy open banking (leave blank for mock checkout).
# API credentials are platform-wide. BANK_* is the account that receives credit pack purchases.
# Each venue sets its own membership payout account, till API, and magstripe prefix in Venue settings.
# HOPEMACY_BASE_URL=https://pis.hopemacy.com/api/v1
# HOPEMACY_APP_ID=
# HOPEMACY_APP_SECRET=
# HOPEMACY_MAX_AMOUNT=1000
# BANK_ACCOUNT_NAME=Ashlar Technologies
# BANK_SORT_CODE=
# BANK_ACCOUNT_NUMBER=

# Twilio SMS (platform-wide). Each successful SMS uses 0.25 venue credits.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_LOG_FALLBACK=true
# CREDITS_PER_SMS=0.25
