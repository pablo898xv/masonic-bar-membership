# Compose settings for a Hyper-V Ubuntu guest.
# Copied to the repo root as `.env` by deploy/hyperv/bootstrap.sh.
# Docker Compose reads this file automatically.

PUBLISH_HOST=0.0.0.0
COMPOSE_PROFILES=hosting
HOST_DOMAIN=ashlartechnologies.com
NEXT_PUBLIC_BASE_URL=https://membership.ashlartechnologies.com
FIREBASE_JAVA_OPTS=-Xmx768m
FIREBASE_PROJECT_ID=demo-masonic-bar
ACME_EMAIL=webmaster@ashlartechnologies.com
# Comma-separated CIDRs for everything except membership.ashlartechnologies.com.
ADMIN_ACL=10.0.1.0/24,92.207.102.100/30,62.223.215.229/32
